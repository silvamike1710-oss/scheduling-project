# Copy to .env and replace these placeholders. Never commit .env.
ADMIN_USERNAME=replace-with-a-unique-admin-username
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Use at least 32 random characters; see README.md for a generator command.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-email-app-password
CLINIC_EMAIL=clinic@example.com
